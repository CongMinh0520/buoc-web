# ─────────────────────────────────────────────────────────────
# BƯỚC — biến môi trường. Sao chép thành .env (local) hoặc khai báo trên Vercel.
# KHÔNG commit file .env thật.
# ─────────────────────────────────────────────────────────────

# ── Bắt buộc ────────────────────────────────────────────────
# Postgres. Trên Neon: dùng chuỗi "pooled" (host có -pooler), thêm ?sslmode=require
DATABASE_URI=postgres://postgres:postgres@localhost:5432/buoc
# Khóa ký JWT phiên đăng nhập, OTP và token đơn hàng. >= 32 ký tự ngẫu nhiên (npm run setup tự sinh).
#   Tạo nhanh: openssl rand -base64 48
PAYLOAD_SECRET=
# URL công khai của website (không có "/" cuối). Dùng cho canonical, sitemap, OG, CORS/CSRF
# và URL trả về của cổng thanh toán.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (bắt buộc trên production: OTP đăng ký / quên mật khẩu, xác nhận đơn) ──
# Bỏ trống SMTP_HOST ở local: mã OTP được in ra log của server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@buoc-atelier.vn
EMAIL_FROM_NAME=BƯỚC Atelier

# ── Ảnh tải lên (khuyến nghị trên Vercel — filesystem của serverless không lưu lâu dài) ──
# Vercel → Storage → Blob → tạo store, token tự được thêm vào project.
BLOB_READ_WRITE_TOKEN=

# ── Chống spam / brute-force dùng chung cho mọi instance (khuyến nghị trên production) ──
# Upstash Redis (Vercel Marketplace). Bỏ trống: đếm trong bộ nhớ từng instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── VNPay (bỏ trống = ẩn phương thức VNPay) ──────────────────
# Đăng ký sandbox: https://sandbox.vnpayment.vn/devreg/  → nhận TMN code + hash secret qua email
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Production: https://pay.vnpay.vn/vpcpay.html
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# ── MoMo (bỏ trống = ẩn phương thức MoMo) ────────────────────
# Sandbox: https://business.momo.vn  (hoặc bộ khóa test công khai trong tài liệu developers.momo.vn)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Production: https://payment.momo.vn/v2/gateway/api/create
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ── Chỉ dùng khi chạy `npm run seed` ─────────────────────────
# Bỏ trống mật khẩu admin: sinh ngẫu nhiên và in ra màn hình.
SEED_ADMIN_EMAIL=admin@buoc.local
SEED_ADMIN_PASSWORD=
# Mật khẩu khách hàng mẫu (chỉ tạo ở môi trường không phải production)
SEED_DEMO_PASSWORD=
# Cho phép seed khi NODE_ENV=production (chỉ ghi đè nội dung CMS, không đụng khách hàng/đơn hàng)
ALLOW_PROD_SEED=
