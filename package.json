{
  "name": "buoc-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "node scripts/payload-cli.mjs migrate",
    "migrate:create": "payload migrate:create",
    "seed": "node scripts/payload-cli.mjs seed",
    "ci": "node scripts/payload-cli.mjs migrate && next build",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/email-nodemailer": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/plugin-seo": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-vercel-blob": "^3.90.2",
    "@payloadcms/translations": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "graphql": "^16.14.2",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "payload": "^3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "playwright": "^1.56.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  }
}
